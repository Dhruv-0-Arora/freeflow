# Home Manager module for the FreeFlow Linux daemon.
#
# Provides two user services and the Hyprland bindings that drive them.
#
# The bindings use `bindri`, not `bindr`, for every release edge. Hyprland
# filters binds against the current modifier mask on release as well as on
# press, so with a plain `bindr` the release never fires if the user lifts the
# modifier before the main key - and recording would continue until the
# daemon's own watchdog stopped it. The `i` flag ignores modifiers.
{ self }:
{
  config,
  lib,
  pkgs,
  ...
}:
let
  cfg = config.services.freeflow;
  inherit (lib)
    mkEnableOption
    mkOption
    mkIf
    types
    ;

  freeflow = self.packages.${pkgs.stdenv.hostPlatform.system}.freeflow;
  whisper = import ./whisper-server.nix {
    inherit lib pkgs;
    inherit (cfg.whisper) cudaSupport cudaCapabilities;
  };

  modelPath = "${config.xdg.dataHome}/freeflow/models/ggml-${cfg.whisper.model}.bin";

  binds = ''
    # FreeFlow dictation - generated by the home-manager module.
    # `bindri` (not `bindr`) so the release still fires when the modifier is
    # let go before the key.
    bind   = ${cfg.keybinds.hold}, exec, freeflow hold press
    bindri = ${cfg.keybinds.hold}, exec, freeflow hold release
    bind   = ${cfg.keybinds.toggle}, exec, freeflow toggle press
    bindri = ${cfg.keybinds.toggle}, exec, freeflow toggle release
    bind   = ${cfg.keybinds.latch}, exec, freeflow latch
    bind   = ${cfg.keybinds.copyAgain}, exec, freeflow copy-again
    bind   = ${cfg.keybinds.cancel}, exec, freeflow cancel
  '';
in
{
  options.services.freeflow = {
    enable = mkEnableOption "the FreeFlow dictation daemon";

    package = mkOption {
      type = types.package;
      default = freeflow;
      description = "The freeflow package to use.";
    };

    settings = mkOption {
      type = types.attrs;
      default = { };
      description = ''
        Contents of ~/.config/freeflow/config.toml.
        Secrets belong in separate 0600 files referenced by path, never here:
        this value ends up world-readable in the Nix store.
      '';
    };

    keybinds = {
      hold = mkOption {
        type = types.str;
        default = "SUPER_ALT, D";
        description = "Push-to-talk binding. Fn cannot be used: on PC keyboards it is handled in firmware and never reaches the compositor.";
      };
      toggle = mkOption {
        type = types.str;
        default = "SUPER_ALT, T";
        description = "Tap to start, tap again to stop.";
      };
      latch = mkOption {
        type = types.str;
        default = "SUPER_ALT_SHIFT, D";
        description = "Convert an in-progress hold into a toggle.";
      };
      copyAgain = mkOption {
        type = types.str;
        default = "SUPER_ALT, C";
        description = "Re-inject the last result.";
      };
      cancel = mkOption {
        type = types.str;
        default = "SUPER_ALT, Escape";
        description = "Abandon the current dictation.";
      };
    };

    overlay.enable = mkOption {
      type = types.bool;
      default = true;
      description = ''
        Run the layer-shell recording indicator. It is a separate process from
        the daemon so the daemon carries no GUI dependencies.
      '';
    };

    hyprland.enable = mkOption {
      type = types.bool;
      default = true;
      description = "Add the bindings to the Hyprland configuration.";
    };

    whisper = {
      enable = mkOption {
        type = types.bool;
        default = true;
        description = "Run a local whisper-server for transcription.";
      };
      model = mkOption {
        type = types.str;
        default = "large-v3-turbo";
        description = "ggml model name, fetched on first start.";
      };
      port = mkOption {
        type = types.port;
        default = 8080;
      };
      cudaSupport = mkOption {
        type = types.bool;
        default = false;
        description = ''
          Build whisper.cpp against CUDA. Much faster, but the build is long
          and uncached because CUDA is unfree, so this is opt-in.
        '';
      };
      cudaCapabilities = mkOption {
        type = types.listOf types.str;
        default = [ "8.6" ];
        description = "Target GPU architectures. 8.6 is Ampere (RTX 30-series).";
      };
      extraArgs = mkOption {
        type = types.listOf types.str;
        default = [ ];
      };
    };
  };

  config = mkIf cfg.enable {
    home.packages = [ cfg.package ] ++ lib.optional cfg.whisper.enable whisper.fetchModelScript;

    xdg.configFile."freeflow/config.toml" = mkIf (cfg.settings != { }) {
      source = (pkgs.formats.toml { }).generate "freeflow-config.toml" cfg.settings;
    };

    systemd.user.services.freeflow = {
      Unit = {
        Description = "FreeFlow dictation daemon";
        # Needs the compositor: it reads window context and types via the
        # virtual-keyboard protocol.
        PartOf = [ "graphical-session.target" ];
        After = [ "graphical-session.target" ];
      };
      Service = {
        ExecStart = "${cfg.package}/bin/freeflowd";
        Restart = "on-failure";
        RestartSec = 2;
        Environment = [ "FREEFLOW_LOG=freeflow=info,warn" ];
      };
      Install.WantedBy = [ "graphical-session.target" ];
    };

    systemd.user.services.freeflow-overlay = mkIf cfg.overlay.enable {
      Unit = {
        Description = "FreeFlow recording overlay";
        PartOf = [ "graphical-session.target" ];
        After = [ "graphical-session.target" ];
      };
      Service = {
        ExecStart = "${cfg.package}/bin/freeflow-overlay";
        Restart = "on-failure";
        RestartSec = 2;
      };
      Install.WantedBy = [ "graphical-session.target" ];
    };

    systemd.user.services.freeflow-whisper = mkIf cfg.whisper.enable {
      Unit = {
        Description = "whisper.cpp transcription server for FreeFlow";
        PartOf = [ "graphical-session.target" ];
      };
      Service = {
        # Fetch the model before the first start; a no-op once present.
        ExecStartPre = "${whisper.fetchModelScript}/bin/freeflow-fetch-whisper-model ${cfg.whisper.model}";
        ExecStart = lib.escapeShellArgs (
          [
            "${whisper.package}/bin/whisper-server"
            "-m"
            modelPath
            "--host"
            "127.0.0.1"
            "--port"
            (toString cfg.whisper.port)
            # These two flags are what make the server OpenAI-compatible.
            "--request-path"
            "/v1/audio"
            "--inference-path"
            "/transcriptions"
          ]
          ++ cfg.whisper.extraArgs
        );
        Restart = "on-failure";
        RestartSec = 5;
      };
      Install.WantedBy = [ "graphical-session.target" ];
    };

    wayland.windowManager.hyprland.extraConfig = mkIf (
      cfg.hyprland.enable && (config.wayland.windowManager.hyprland.enable or false)
    ) binds;
  };
}
